{
  "name": "agy-manager",
  "version": "1.0.0",
  "description": "Antigravity 家庭双池配额守门员 · Cloudflare Workers + D1",
  "scripts": {
    "predev": "npm run setup:local",
    "dev": "wrangler dev --ip 127.0.0.1",
    "setup:local": "node scripts/setup-local.mjs",
    "setup:cloud": "node scripts/prepare-cloud.mjs",
    "typecheck": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "test": "npm run build && node --import tsx --test tests/*.test.ts tests/*.test.mjs",
    "check": "npm run typecheck && npm test",
    "deploy": "wrangler d1 migrations apply agy-family-quota --remote && wrangler deploy",
    "client:install": "node public/client/install.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@types/node": "^26.6.6",
    "miniflare": "^5.20261110.0-beta",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wrangler": "^4.160.0"
  },
  "private": true
}
